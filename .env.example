# Copier en .env et renseigner. Ne jamais versionner .env.

# Base MySQL. Le port peut être donné dans DB_HOST (MAMP : 127.0.0.1:8889).
DB_HOST=127.0.0.1:8889
DB_NAME=noorwan_site
# Utilisateur du site : INSERT seulement sur contact_requests (le site ne lit jamais la table).
DB_USER=
DB_PASS=
# Utilisateur de maintenance (bin/purge-contacts.php) : SELECT et DELETE sur contact_requests.
# Vide en local : DB_USER sert alors aux deux.
DB_MAINT_USER=
DB_MAINT_PASS=

# local, staging ou production. Hors local, les erreurs PHP sont masquées ;
# hors production, le site demande à ne pas être indexé (X-Robots-Tag, robots.txt).
APP_ENV=local
# URL publique du dossier public/, sans barre finale (sert aux balises canonique et hreflang).
APP_URL=http://localhost:8888/noorwan-site/public

# Secret aléatoire d'au moins 32 caractères : signe le jeton du formulaire et sale l'empreinte des IP.
# Générer avec : php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_SECRET=
