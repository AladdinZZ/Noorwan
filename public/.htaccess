Options -Indexes
DirectoryIndex index.php

# Aucun fichier caché (.htaccess, .env éventuel) n'est servi.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# robots.txt et sitemap.xml sont produits par PHP : leur contenu dépend de APP_ENV.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    # Pages Consulting et Noorwan Connect aux adresses courtes /consulting et /connect.
    RewriteRule ^consulting$ consulting.php [L]
    RewriteRule ^connect$ connect.php [L]
</IfModule>
